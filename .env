# === Keycloak admin ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# === PostgreSQL (catalogue-db) ===
CATALOGUE_DB_USER=catalogue
CATALOGUE_DB_PASSWORD=catalogue
CATALOGUE_DB_NAME=catalogue

# === Mongo DB ===
FEEDBACK_MONGODB_URI=mongodb://feedback-db:27017/feedback

# === Общее для всех Java-сервисов ===
MY_SELMAG_APP_HOSTNAME=MY-dev-comp

# === SERVICES PORTS ===

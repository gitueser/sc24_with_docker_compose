# === Общее для всех Java-сервисов ===
MY_SELMAG_APP_HOSTNAME=MY-dev-comp

# === Keycloak admin ===
# Поскольку эти URL показываются/используются в браузере через Swagger UI,
# в k8s имеет смысл сделать KEYCLOAK_PUBLIC_URI внешним (Ingress hostname):
KEYCLOAK_ADMIN=admin
KEYCLOAK_PUBLIC_URI=http://keycloak.selm.ag.192.168.49.2.nip.io
KEYCLOAK_ISSUER_URI=http://keycloak.selm.ag.192.168.49.2.nip.io/realms/selmag
KC_HOSTNAME_URL=http://keycloak.selm.ag.192.168.49.2.nip.io
KC_HOSTNAME_STRICT=false
KC_PROXY=edge
KEYCLOAK_METRICS_TOKEN_URL=http://selmag-keycloak-svc:8080/realms/selmag/protocol/openid-connect/token

# === PostgreSQL (catalogue-db) ===
CATALOGUE_DB_USER=catalogue
CATALOGUE_DB_NAME=catalogue
CATALOGUE_DB_JDBC_URL=jdbc:postgresql://selmag-catalogue-db-svc:5432/catalogue

# === Mongo DB ===
FEEDBACK_MONGODB_URI=mongodb://selmag-feedback-db-svc:27017/feedback

# === config-server credentials ===
CONFIG_SERVER_SECURITY_USERNAME=config_kubernetes_user

# === OIDC clients (Keycloak) their IDs===
ADMIN_SERVICE_CLIENT_ID=admin-service
API_GATEWAY_CLIENT_ID=api-gateway
CATALOGUE_SERVICE_CLIENT_ID=catalogue-service
CUSTOMER_APP_CLIENT_ID=customer-app
CUSTOMER_APP_GATEWAY_CLIENT_ID=customer-app-nip.io
EUREKA_SERVER_CLIENT_ID=eureka-server
FEEDBACK_SERVICE_CLIENT_ID=feedback-service
MANAGER_APP_CLIENT_ID=manager-app
MANAGER_APP_GATEWAY_CLIENT_ID=manager-app-nip.io
VICTORIA_METRICS_CLIENT_ID=victoria-metrics

# === logging and metrics ===
TEMPO_ZIPKIN_ENDPOINT=http://selmag-tempo-svc:9411/api/v2/spans

# === SERVICES URI's and HOSTS===
CATALOGUE_SERVICE_URI=lb://selmag-catalogue-service
FEEDBACK_SERVICE_URI=lb://selmag-feedback-service
CUSTOMER_APP_URI=lb://selmag-customer-app
MANAGER_APP_URI=lb://selmag-manager-app

NIP_IO_IP=192.168.49.2
NIP_IO_SUFFIX=nip.io
SELMAG_BASE_DOMAIN=selm.ag

CATALOGUE_SUBDOMAIN=catalogue.api
FEEDBACK_SUBDOMAIN=feedback.api
MANAGER_SUBDOMAIN=manager
CUSTOMER_SUBDOMAIN=customer
CONFIG_SUBDOMAIN=config

# === SERVICES PORTS ===
KEYCLOAK_PORT_EXTERNAL=8080
KEYCLOAK_PORT_INTERNAL=8080

CATALOGUE_DB_PORT_EXTERNAL=5432
CATALOGUE_DB_PORT_INTERNAL=5432

FEEDBACK_DB_PORT_EXTERNAL=27017
FEEDBACK_DB_PORT_INTERNAL=27017

ADMIN_SERVER_PORT_EXTERNAL=8085
ADMIN_SERVER_PORT_INTERNAL=8085
ADMIN_HOSTNAME=selmag-admin-server-svc

API_GATEWAY_PORT_EXTERNAL=8086
API_GATEWAY_PORT_INTERNAL=8086

CATALOGUE_SERVICE_PORT_EXTERNAL=8081
CATALOGUE_SERVICE_PORT_INTERNAL=8081

CONFIG_SERVER_PORT_EXTERNAL=8888
CONFIG_SERVER_PORT_INTERNAL=8888
CONFIG_SERVER_URI=http://selmag-config-server-svc:8888

CUSTOMER_APP_PORT_EXTERNAL=8083
CUSTOMER_APP_PORT_INTERNAL=8083
CUSTOMER_APP_HOSTNAME=selmag-customer-app-svc

EUREKA_SERVER_PORT_EXTERNAL=8761
EUREKA_SERVER_PORT_INTERNAL=8761
EUREKA_HOSTNAME=selmag-eureka-server-svc
EUREKA_DEFAULTZONE=http://selmag-eureka-server-svc:8761/eureka/

FEEDBACK_SERVICE_PORT_EXTERNAL=8084
FEEDBACK_SERVICE_PORT_INTERNAL=8084

MANAGER_APP_PORT_EXTERNAL=8087
MANAGER_APP_PORT_INTERNAL=8087
